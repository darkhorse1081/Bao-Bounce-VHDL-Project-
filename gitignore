# Ignore everything
*

# Except for .gitignore file
!.gitignore

# Except for vhdl files (source files)
!*.vhd

# Even in subdirectories
!*/


# Except for .json files (vscode settings)
!extensions.json
!settings.json

# Except for .mif files (memory initialization files)
!*.MIF
!*.mif

# Except for .qsf files (Quartus settings files)
!*.qsf
!*.qpf

# Except for PLL autogenerated files
!*.spd
!*.sip
!*.qip
!*.ppf
!*.cmp
!*.bsf
!*_sim.f
!*.tcl
!*.sh
!*.vho
!*.lib
!*.var
!*.setup
!*.v

# VHDL Language Server configuration file
!vhdl_ls.toml

# Add additional files to keep here (for example, python and java programs)
!*.py
!*.java